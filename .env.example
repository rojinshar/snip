# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Mathpix Convert API credentials, used as the reference engine.
# https://mathpix.com/docs/convert/overview
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Self-hosted UniMERNet server (apps/unimernet-server). Default shown.
# UNIMERNET_URL=http://127.0.0.1:8765

# apps/api (optional; defaults shown)
# PORT=8790
# HOST=127.0.0.1

# Desktop release signing and notarization (npm run release:desktop). Not needed for
# npm run build:desktop, which signs ad hoc for local use.
# APPLE_SIGNING_IDENTITY="Developer ID Application: <Org> (<TEAMID>)"
# APPLE_API_ISSUER=<App Store Connect API issuer ID>
# APPLE_API_KEY=<App Store Connect API key ID>
# APPLE_API_KEY_PATH=~/.appstoreconnect/AuthKey_<KEYID>.p8
# TAURI_SIGNING_PRIVATE_KEY=~/.tauri/snip-updater.key   (npx tauri signer generate)
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=<its password>
