{
  "name": "snip",
  "version": "0.0.0",
  "private": true,
  "description": "Screenshot any equation, paste LaTeX.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b && npm run typecheck --workspace @snip/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "bench": "npm run start --workspace @snip/bench --",
    "bench:import-unimer": "npm run import:unimer --workspace @snip/bench --",
    "bench:rescore": "npm run rescore --workspace @snip/bench --",
    "dev:web": "npm run dev --workspace @snip/web",
    "dev:desktop": "npm run dev --workspace @snip/desktop",
    "build:desktop": "npm run build --workspace @snip/desktop",
    "release:desktop": "bash apps/desktop/scripts/release.sh",
    "publish:desktop": "bash apps/desktop/scripts/publish.sh",
    "reset:desktop-permission": "npm run reset-permission --workspace @snip/desktop",
    "dev:api": "npm run dev --workspace @snip/api",
    "db:migrate": "npm run migrate --workspace @snip/db",
    "keys": "npm run keys --workspace @snip/api --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.9"
  }
}
